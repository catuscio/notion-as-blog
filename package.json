{
  "name": "notion-as-blog",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node --env-file-if-exists=.env.local .next/standalone/server.js",
    "lint": "eslint",
    "cleancache": "rm -rf .next",
    "test:security": "node --no-warnings --experimental-loader ./scripts/typescript-loader.mjs scripts/security-helpers.test.mjs",
    "test:visibility": "node --no-warnings --experimental-loader ./scripts/typescript-loader.mjs scripts/content-visibility.test.mjs",
    "test:mapping": "node --no-warnings --experimental-loader ./scripts/typescript-loader.mjs scripts/content-mapping.test.mjs",
    "test:presentation": "node --no-warnings --experimental-loader ./scripts/typescript-loader.mjs scripts/presentation-helpers.test.mjs",
    "test": "npm run test:security && npm run test:visibility && npm run test:mapping && npm run test:presentation"
  },
  "dependencies": {
    "@notionhq/client": "^5.23.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "feed": "^6.0.0",
    "katex": "^0.17.0",
    "lucide-react": "^1.24.0",
    "mermaid": "^11.16.0",
    "next": "16.2.10",
    "radix-ui": "^1.6.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sharp": "0.34.5",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.10",
    "shadcn": "^4.13.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "postcss": "8.5.16"
  },
  "allowScripts": {
    "fsevents@2.3.2": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.11.1": true
  }
}
