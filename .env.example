# Notion Configuration
NOTION_API_KEY=
NOTION_DATA_SOURCE_ID=
NOTION_AUTHORS_DATA_SOURCE_ID=
# Optional: separate HMAC secret for stable Notion image proxy URLs.
# Defaults to NOTION_API_KEY when omitted.
NOTION_IMAGE_SIGNING_SECRET=
# Optional: CDN cache TTL for proxied Notion files.
# Capped at 3300 seconds to stay below Notion signed URL expiry.
NOTION_IMAGE_CACHE_SECONDS=3300

# Revalidation
TOKEN_FOR_REVALIDATE=

# Analytics
NEXT_PUBLIC_GA_ID=
